<Page x:Class="_0311library.megjelenit.ujhozzaad"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_0311library.megjelenit"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ujhozzaad">

    <Grid Background="White">

        <Label Content="cím" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="129,48,0,0"/>
        <Label Content="szerző" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="286,48,0,0"/>
        <Label Content="kiadási év" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="465,48,0,0"/>
        <Label Content="ár" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="697,48,0,0"/>
        <TextBox x:Name="ujhozzaadTitle" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Margin="83,93,0,0" />
        <TextBox x:Name="ujhozzaadAuthor" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Margin="248,93,0,0"/>
        <TextBox x:Name="ujhozzaadYear" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Margin="436,93,0,0"/>
        <TextBox x:Name="ujhozzaadPrice" HorizontalAlignment="Left" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" Margin="637,93,0,0"/>
        <StackPanel Height="200px">
            <Button x:Name="hozzaadgomb" Content="Hozzáad" Height="56" Width="108" Click="hozzaadgomb_Click"/>
        </StackPanel>
    </Grid>
</Page>
